<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <EditText
        android:id="@+id/etIngredientName"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="4"
        android:background="@drawable/bg_input_field"
        android:hint="Tên nguyên liệu *"
        android:paddingHorizontal="10dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="textCapSentences"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etIngredientQuantity"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="2"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Số lượng"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/etIngredientUnit"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="2"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Đơn vị (g, ml...)"
        android:paddingHorizontal="8dp"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="text"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/btnRemoveIngredient"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:padding="8dp"
        android:src="@drawable/ic_trash"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xóa nguyên liệu" />

</LinearLayout>
